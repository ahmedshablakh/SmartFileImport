{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FileProcessing": {
    "InputFolder": "Files/Incoming",
    "ProcessedFolder": "Files/Processed",
    "ErrorFolder": "Files/Error",
    "ScanIntervalSeconds": 5
  },
  "AllowedHosts": "*"
}
